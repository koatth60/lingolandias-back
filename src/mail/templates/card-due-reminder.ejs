<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Card Due Soon - Lingolandias</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f0eef5; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;">
  <table width="100%" border="0" cellspacing="0" cellpadding="0" style="background-color: #f0eef5;">
    <tr>
      <td align="center" style="padding: 40px 20px;">
        <table width="100%" style="max-width: 600px; border-radius: 16px; overflow: hidden; box-shadow: 0 8px 40px rgba(0,0,0,0.18);">

          <!-- Header -->
          <tr>
            <td style="background: linear-gradient(135deg, #0d0a1e 0%, #1a1a2e 55%, #110e28 100%); padding: 40px 30px; text-align: center;">
              <img src="https://lingolandias-academy.s3.eu-north-1.amazonaws.com/general-images/logo.png" alt="Lingolandias" style="height: 72px; margin-bottom: 20px; display: block; margin-left: auto; margin-right: auto;">
              <h1 style="color: #ffffff; margin: 0 0 8px 0; font-size: 26px; font-weight: 800; letter-spacing: -0.5px;">Card Due Soon</h1>
              <p style="color: rgba(255,255,255,0.5); margin: 0; font-size: 14px;">A Trello 2.0 card on your board needs attention</p>
            </td>
          </tr>

          <!-- Content -->
          <tr>
            <td style="background-color: #ffffff; padding: 40px 30px;">
              <p style="font-size: 16px; color: #222; margin: 0 0 20px 0;">Hi <strong><%= name %></strong>,</p>

              <table width="100%" border="0" cellspacing="0" cellpadding="0" style="margin-bottom: 24px;">
                <tr>
                  <td style="background: #f9f5ff; border: 1px solid rgba(158,47,208,0.2); border-radius: 12px; padding: 20px 24px;">
                    <p style="margin: 0 0 6px 0; font-size: 17px; color: #222; font-weight: 700;"><%= cardName %></p>
                    <p style="margin: 0 0 10px 0; font-size: 13px; color: #888;"><%= boardName %> &rsaquo; <%= listName %></p>
                    <p style="margin: 0; font-size: 14px; color: #9E2FD0; font-weight: 600;">Due <%= dueDate %></p>
                  </td>
                </tr>
              </table>

              <table width="100%" border="0" cellspacing="0" cellpadding="0">
                <tr>
                  <td align="center">
                    <a href="<%= boardUrl %>" style="display: inline-block; background: #9E2FD0; color: #ffffff; text-decoration: none; font-weight: 600; font-size: 14px; padding: 12px 28px; border-radius: 10px;">
                      Open board
                    </a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="background: #0d0a1e; padding: 24px 30px; text-align: center;">
              <p style="margin: 0 0 8px 0; font-size: 12px; color: rgba(255,255,255,0.35);">
                Manage reminders anytime in Settings &rarr; Notifications.
              </p>
              <p style="margin: 0; font-size: 12px; color: rgba(255,255,255,0.25);">&copy; 2025 Lingolandias. All rights reserved.</p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
